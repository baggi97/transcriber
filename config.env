# Fælles indstillinger for installation, opdatering og selve appen.
# Skal kunne læses både af bash og af appen, så brug kun linjer på formen NØGLE="værdi".

# Dit repo på GitHub (brugernavn/reponavn). Skal være offentligt, for at opdateringer kan hentes uden login.
GITHUB_REPO="baggi97/transcriber"

# Sprogmodellen der bruges til transskribering
MODEL="mlx-community/whisper-large-v3-turbo"
